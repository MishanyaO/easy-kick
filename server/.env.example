KICK_CLIENT_ID=app-client-id
KICK_CLIENT_SECRET=app-client-secret
KICK_REDIRECT_URI=https://<domain>.ngrok-free.dev/auth/callback
KICK_PUBLIC_BASE_URL=https://<domain>.ngrok-free.dev
KICK_BUFFER_SIZE=10000
KICK_SIMULATOR_ENABLED=false  # set true to enable POST /dev/replay
KICK_CONTROLLER_ENABLED=false
# KICK_BROADCASTER_USER_ID=123
# KICK_BOT_USER_ID=123          # stable posting user id; defaults to broadcaster id
KICK_CONTROLLER_WARMUP_S=60
KICK_CONTROL_API_KEY=          # set when exposing controller routes through a tunnel
